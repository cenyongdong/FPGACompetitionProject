# JFMQL30TAI_LITE.pdf, actual PDF pages 9/10/21/22 (1-based).
# AC14: BANK12, VCC3V3, 100 MHz single-ended oscillator G1.
set_property PACKAGE_PIN AC14 [get_ports clk_100m]
set_property IOSTANDARD LVCMOS33 [get_ports clk_100m]
create_clock -name pl_100mhz -period 10.000 [get_ports clk_100m]

# LED1/2: BANK33; LED3/4: BANK34; both VCCO = PL_VCC1V5.
# NDS331N low-side switches: high at the FPGA pin lights the LED.
set_property PACKAGE_PIN J1 [get_ports {led[0]}]
set_property PACKAGE_PIN M6 [get_ports {led[1]}]
set_property PACKAGE_PIN H7 [get_ports {led[2]}]
set_property PACKAGE_PIN J8 [get_ports {led[3]}]
set_property IOSTANDARD LVCMOS15 [get_ports {led[*]}]
set_property DRIVE 4 [get_ports {led[*]}]
set_property SLEW SLOW [get_ports {led[*]}]

# Human-visible LED outputs have no external synchronous sampling contract.
# No fictional output delay or timing exception is added to hide this fact.
