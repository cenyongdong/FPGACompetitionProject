# Offline IO compatibility only: forward the documented AC14 100MHz oscillator
# into the HDMI clock pair. This is NOT a 1485Mb/s serializer or video design.
# Native place/route acceptance does not provide a full HDMI timing signoff.
set_property PACKAGE_PIN AC14 [get_ports serial_bit]
set_property IOSTANDARD LVCMOS33 [get_ports serial_bit]
create_clock -name compatibility_100m -period 10.000 [get_ports serial_bit]
set_property PACKAGE_PIN AC17 [get_ports tmds_p]
set_property PACKAGE_PIN AC16 [get_ports tmds_n]
set_property IOSTANDARD TMDS_33 [get_ports tmds_p]
set_property IOSTANDARD TMDS_33 [get_ports tmds_n]
